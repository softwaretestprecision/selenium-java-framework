<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Software Test Precision - Selenium TestNG Framework" parallel="methods" thread-count="3">
  <listeners>
    <listener class-name="com.softwaretestprecision.tests.listeners.ScreenshotOnFailureListener"/>
  </listeners>
  <test name="Regression">
    <classes>
      <class name="com.softwaretestprecision.tests.LoginTest"/>
      <class name="com.softwaretestprecision.tests.InventoryTest"/>
      <class name="com.softwaretestprecision.tests.CheckoutTest"/>
    </classes>
  </test>
</suite>
